# Postgres connection string (Supabase).
DATABASE_URL=""

# Google OAuth (NextAuth), shared with the admin allowlist below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Session/CSRF signing secret for NextAuth. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Admin allowlist: signing in with one of these emails grants admin access.
ADMIN_EMAIL_JADD=""
ADMIN_EMAIL_WIRRALBEARS=""
ADMIN_EMAIL_MARTIN=""
ADMIN_EMAIL_DOWDSTERS=""
ADMIN_EMAIL_SKYE=""

# UploadThing.
UPLOADTHING_TOKEN=""
UPLOAD_THING_APP_ID=""

# UploadThing app id, used client-side to build public file URLs.
NEXT_PUBLIC_UPLOAD_THING_APP_ID=""
# Mapbox public token for the location map.
NEXT_PUBLIC_MAPBOX_TOKEN=""
