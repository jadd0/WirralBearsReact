# Origin of the Express API (apps/backend), deployed separately.
NEXT_PUBLIC_SERVER_ORIGIN="https://api.wirralbears.com"
# UploadThing app id, used to build public file URLs.
NEXT_PUBLIC_UPLOAD_THING_APP_ID=""
# Mapbox public token for the location map.
NEXT_PUBLIC_MAPBOX_TOKEN=""
# Set to "true" in production to keep the idling API warm.
NEXT_PUBLIC_ENABLE_KEEPALIVE="true"
